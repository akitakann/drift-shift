{
    "version": 4,
    "configurations": [
        {
            "name": "Emscripten",
            "compilerPath": "/emsdk/upstream/emscripten/em++",
            "compilerArgs": [
                "-sUSE_SDL=2",
                "-sUSE_SDL_IMAGE=2",
                "-sUSE_SDL_MIXER=2"
            ],
            "includePath": [
                "${workspaceFolder}/src/**",
                "/emsdk/upstream/emscripten/cache/sysroot/include/SDL2",
                "/emsdk/upstream/emscripten/cache/sysroot/include"
            ],
            "defines": [
                "__EMSCRIPTEN__"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "clang-x64"
        },
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/g++",
            "includePath": [
                "${workspaceFolder}/src/**",
                "/usr/include/SDL2"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
