{
    "name": "Race Game Build Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Linux ネイティブ版のゲームウィンドウを表示するための軽量デスクトップ。
    // ブラウザで http://localhost:6080 を開くとコンテナ内の画面が見えます。
    // （パスワードは vscode）
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {}
    },

    // コンテナ内で有効化するVS Code拡張機能
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "twxs.cmake",
                "ms-vscode.cmake-tools",
                // wasm(C++) を VS Code でデバッグするために必要（変数の確認に使用）
                "ms-vscode.wasm-dwarf-debugging",
                "GitHub.copilot"
            ]
        }
    },

    // 8080: ブラウザ版を配信するWebサーバー
    // 6080: Linux ネイティブ版の画面を見るためのデスクトップ（noVNC）
    // forwardPorts はエディタのポート転送だけなので、ホストのブラウザの
    // localhost には届かない。Docker がポートを公開する。
    "forwardPorts": [8080, 6080],
    "runArgs": ["--publish", "8080:8080", "--publish", "6080:6080"],
    "portsAttributes": {
        "8080": {
            "label": "ブラウザ版のWebサーバー"
        },
        "6080": {
            "label": "Linux版の画面（noVNC）"
        }
    },

    // DISPLAY          : ネイティブ版のウィンドウを上のデスクトップに表示する
    // SDL_AUDIODRIVER  : コンテナには音声デバイスが無いため、ダミーで代用する。
    //                    これを指定しないと Mix_OpenAudio が失敗して起動できない。
    "remoteEnv": {
        "DISPLAY": ":1",
        "SDL_AUDIODRIVER": "dummy"
    },

    "postCreateCommand": "echo 'Race Game environment is ready!'"
}
